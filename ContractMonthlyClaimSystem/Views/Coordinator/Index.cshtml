@{
    ViewData["Title"] = "Coordinator Dashboard";
}

<div class="row">
    <div class="col-12">
        <h2>Coordinator Dashboard</h2>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h5 class="card-title">Pending Claims</h5>
                <h2 class="card-text">@ViewBag.PendingCount</h2>
                <a asp-action="ReviewClaims" class="btn btn-light mt-2">Review Now</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">Total Claims</h5>
                <h2 class="card-text">@ViewBag.TotalCount</h2>
                <a asp-action="AllClaims" class="btn btn-light mt-2">View All</a>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <h4>Quick Actions</h4>
        <div class="btn-group" role="group">
            <a asp-action="ReviewClaims" class="btn btn-primary">
                <i class="bi bi-clipboard-check"></i> Review Pending Claims
            </a>
            <a asp-action="AllClaims" class="btn btn-secondary">
                <i class="bi bi-list"></i> View All Claims
            </a>
        </div>
    </div>
</div>