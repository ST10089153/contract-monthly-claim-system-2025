@model List<CMCS.Models.Claim>
@{
    ViewData["Title"] = "Review All Claims";
}

<div class="row">
    <div class="col-12">
        <h2>All Claims</h2>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-12">
        @if (Model != null && Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Lecturer</th>
                            <th>Date</th>
                            <th>Hours</th>
                            <th>Rate</th>
                            <th>Total</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.OrderByDescending(c => c.SubmissionDate))
                        {
                            <tr>
                                <td>#@claim.ClaimId</td>
                                <td>@claim.LecturerName</td>
                                <td>@claim.SubmissionDate.ToString("yyyy-MM-dd")</td>
                                <td>@claim.HoursWorked</td>
                                <td>R @claim.HourlyRate</td>
                                <td>R @claim.TotalAmount.ToString("N2")</td>
                                <td>
                                    @if (claim.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">Pending</span>
                                    }
                                    else if (claim.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else
                                    {
                                        <span class="badge @(claim.Status == "Paid" ? "bg-primary" : "bg-danger")">@claim.Status</span>
                                    }
                                </td>
                                <td>
                                    @if (claim.Status == "Pending")
                                    {
                                        <form asp-action="ApproveClaim" asp-route-id="@claim.ClaimId" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                        </form>
                                        <form asp-action="RejectClaim" asp-route-id="@claim.ClaimId" method="post" style="display:inline;">
                                            <button type="submit" class="btn btn-sm btn-danger">Reject</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> No claims found.
            </div>
        }
    </div>
</div>