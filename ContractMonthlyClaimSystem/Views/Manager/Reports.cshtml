@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Claims Reports";
}

<div class="container mt-4">
    <h2>Monthly Claims Report</h2>
    <hr />

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Year</th>
                    <th>Month</th>
                    <th>Total Claims</th>
                    <th>Approved Claims</th>
                    <th>Total Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.Year</td>
                            <td>@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(item.Month)</td>
                            <td>@item.TotalClaims</td>
                            <td>@item.TotalApproved</td>
                            <td>R @item.TotalAmount.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">No data available</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>