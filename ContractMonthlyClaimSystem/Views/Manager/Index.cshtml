@{
    ViewData["Title"] = "Manager Dashboard";
}

<div class="row">
    <div class="col-12">
        <h2>Manager Dashboard</h2>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5 class="card-title">Total Claims</h5>
                <h2 class="card-text">@ViewBag.TotalClaims</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h5 class="card-title">Pending</h5>
                <h2 class="card-text">@ViewBag.PendingClaims</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">Approved</h5>
                <h2 class="card-text">@ViewBag.ApprovedClaims</h2>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">Total Amount</h5>
                <h4 class="card-text">R @(ViewBag.TotalAmount ?? 0)</h4>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-clipboard-check" style="font-size: 48px; color: #007bff;"></i>
                <h5 class="card-title mt-3">Review Claims</h5>
                <p class="card-text">Approve or reject pending claims</p>
                <a asp-action="ReviewClaims" class="btn btn-primary">Review Claims</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card">
            <div class="card-body text-center">
                <i class="bi bi-bar-chart" style="font-size: 48px; color: #28a745;"></i>
                <h5 class="card-title mt-3">View Reports</h5>
                <p class="card-text">Monthly summary and analytics</p>
                <a asp-action="Reports" class="btn btn-success">View Reports</a>
            </div>
        </div>
    </div>
</div>