@model IEnumerable<CMCS.Models.User>

@{
    ViewData["Title"] = "Manage Lecturers";
}

<div class="container mt-4">
    <h2>Manage Lecturers</h2>
    <p class="text-muted">View and manage lecturer information</p>
    <hr />

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Lecturer ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Username</th>
                    <th>Status</th>
                    <th>Created Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var lecturer in Model)
                    {
                        <tr>
                            <td>@lecturer.UserId</td>
                            <td>@lecturer.FullName</td>
                            <td>@lecturer.Email</td>
                            <td>@lecturer.Username</td>
                            <td>
                                @if (lecturer.IsActive)
                                {
                                    <span class="badge bg-success">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Inactive</span>
                                }
                            </td>
                            <td>@lecturer.CreatedDate.ToString("dd MMM yyyy")</td>
                            <td>
                                <a href="#" class="btn btn-sm btn-info">View Details</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No lecturers found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>