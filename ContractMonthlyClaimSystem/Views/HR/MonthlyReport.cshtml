@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Monthly Report";
}

<div class="container mt-4">
    <h2>Monthly Claims Report</h2>
    <h4 class="text-muted">@ViewBag.Month</h4>
    <hr />

    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Claims</h5>
                    <h2>@ViewBag.TotalClaims</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white">
                <div class="card-body">
                    <h5 class="card-title">Total Amount</h5>
                    <h2>R @ViewBag.TotalAmount.ToString("N2")</h2>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white">
                <div class="card-body">
                    <h5 class="card-title">Average Per Claim</h5>
                    <h2>R @(ViewBag.TotalClaims > 0 ? (ViewBag.TotalAmount / ViewBag.TotalClaims).ToString("N2") : "0.00")</h2>
                </div>
            </div>
        </div>
    </div>

    <h4>Breakdown by Status</h4>
    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Status</th>
                    <th>Number of Claims</th>
                    <th>Total Amount</th>
                    <th>Average Amount</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">@item.Status</span>
                                }
                                else if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning">@item.Status</span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="badge bg-danger">@item.Status</span>
                                }
                                else if (item.Status == "Paid")
                                {
                                    <span class="badge bg-primary">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                            </td>
                            <td>@item.Count</td>
                            <td>R @item.TotalAmount.ToString("N2")</td>
                            <td>R @((item.TotalAmount / item.Count).ToString("N2"))</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4" class="text-center">No claims data for this month</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
        <a asp-action="ViewInvoices" class="btn btn-primary">View Invoices</a>
    </div>
</div>