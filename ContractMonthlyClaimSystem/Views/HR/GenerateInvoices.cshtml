@model IEnumerable<CMCS.Models.Claim>

@{
    ViewData["Title"] = "Generate Invoices";
}

<div class="container mt-4">
    <h2>Generate Invoices</h2>
    <p class="text-muted">Review approved claims and generate invoices for payment</p>
    <hr />

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Claim ID</th>
                    <th>Lecturer</th>
                    <th>Submission Date</th>
                    <th>Hours Worked</th>
                    <th>Hourly Rate</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var claim in Model)
                    {
                        <tr>
                            <td>@claim.ClaimId</td>
                            <td>@claim.LecturerName</td>
                            <td>@claim.SubmissionDate.ToString("dd MMM yyyy")</td>
                            <td>@claim.HoursWorked</td>
                            <td>R @claim.HourlyRate.ToString("N2")</td>
                            <td><strong>R @claim.TotalAmount.ToString("N2")</strong></td>
                            <td>
                                @if (claim.Status == "Paid")
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else if (claim.Status == "Approved")
                                {
                                    <span class="badge bg-warning">Ready for Payment</span>
                                }
                                else
                                {
                                    <span class="badge bg-info">@claim.Status</span>
                                }
                            </td>
                        </tr>
                    }

                    <tr class="table-light">
                        <td colspan="5" class="text-end"><strong>Total Amount:</strong></td>
                        <td colspan="2"><strong>R @Model.Sum(c => c.TotalAmount).ToString("N2")</strong></td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No approved claims available for invoicing</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-action="ViewInvoices" class="btn btn-primary">View All Invoices</a>
        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>