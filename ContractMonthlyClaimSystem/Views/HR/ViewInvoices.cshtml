@model IEnumerable<CMCS.Models.Claim>

@{
    ViewData["Title"] = "View Invoices";
}

<div class="container mt-4">
    <h2>Approved Claims / Invoices</h2>
    <hr />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Claim ID</th>
                    <th>Lecturer</th>
                    <th>Submission Date</th>
                    <th>Hours Worked</th>
                    <th>Hourly Rate</th>
                    <th>Total Amount</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var claim in Model)
                    {
                        <tr>
                            <td>@claim.ClaimId</td>
                            <td>@claim.LecturerName</td>
                            <td>@claim.SubmissionDate.ToString("dd MMM yyyy")</td>
                            <td>@claim.HoursWorked</td>
                            <td>R @claim.HourlyRate.ToString("N2")</td>
                            <td><strong>R @claim.TotalAmount.ToString("N2")</strong></td>
                            <td>
                                @if (claim.Status == "Paid")
                                {
                                    <span class="badge bg-success">@claim.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@claim.Status</span>
                                }
                            </td>
                            <td>
                                @if (claim.Status != "Paid")
                                {
                                    <form method="post" asp-action="MarkAsPaid" asp-route-claimId="@claim.ClaimId" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-success"
                                                onclick="return confirm('Mark this claim as paid?')">
                                            Mark as Paid
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="text-success">✓ Paid</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center">No approved claims found</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
    </div>
</div>