@{
    ViewData["Title"] = "HR Dashboard";
}

<div class="row">
    <div class="col-12">
        <h2>HR Dashboard</h2>
        <hr />
    </div>
</div>

<div class="row">
    <div class="col-md-4">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5>Approved Claims</h5>
                <h2>@ViewBag.ApprovedClaims</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-warning text-white">
            <div class="card-body">
                <h5>Pending Claims</h5>
                <h2>@ViewBag.PendingClaims</h2>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5>Total Payments</h5>
                <h3>R @(((decimal)ViewBag.TotalPayments).ToString("N2"))</h3>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-3">
        <a asp-action="GenerateInvoices" class="btn btn-primary btn-block">
            <i class="bi bi-file-earmark-text"></i> Generate Invoices
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="ViewInvoices" class="btn btn-info btn-block">
            <i class="bi bi-list"></i> View Invoices
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="MonthlyReport" class="btn btn-success btn-block">
            <i class="bi bi-bar-chart"></i> Monthly Report
        </a>
    </div>
    <div class="col-md-3">
        <a asp-action="ManageLecturers" class="btn btn-warning btn-block">
            <i class="bi bi-people"></i> Manage Lecturers
        </a>
    </div>
</div>