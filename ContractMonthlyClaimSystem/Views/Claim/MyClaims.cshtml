@model List<CMCS.Models.Claim>
@{
    ViewData["Title"] = "My Claims";
}

<div class="row">
    <div class="col-12">
        <h2>My Claims</h2>
        <hr />
        <a asp-action="Submit" class="btn btn-primary mb-3">
            <i class="bi bi-plus"></i> Submit New Claim
        </a>
    </div>
</div>

<div class="row">
    <div class="col-12">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Claim ID</th>
                            <th>Submission Date</th>
                            <th>Hours Worked</th>
                            <th>Hourly Rate</th>
                            <th>Total Amount</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var claim in Model.OrderByDescending(c => c.SubmissionDate))
                        {
                            <tr>
                                <td>#@claim.ClaimId</td>
                                <td>@claim.SubmissionDate.ToString("yyyy-MM-dd")</td>
                                <td>@claim.HoursWorked</td>
                                <td>R @claim.HourlyRate</td>
                                <td>R @claim.TotalAmount.ToString("N2")</td>
                                <td>
                                    @if (claim.Status == "Pending")
                                    {
                                        <span class="badge bg-warning">@claim.Status</span>
                                    }
                                    else if (claim.Status == "Approved")
                                    {
                                        <span class="badge bg-success">@claim.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">@claim.Status</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Track" asp-route-id="@claim.ClaimId" class="btn btn-sm btn-info">
                                        <i class="bi bi-eye"></i> Track
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info">
                <i class="bi bi-info-circle"></i> You have not submitted any claims yet.
                <a asp-action="Submit" class="alert-link">Submit your first claim</a>
            </div>
        }
    </div>
</div>